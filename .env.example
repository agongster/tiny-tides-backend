# Copy to .env for local development. Never commit .env.
# On Render these are set under the service's Environment tab instead.

# Neon's *pooled* connection string. Leave unset locally to use a SQLite file.
DATABASE_URL=

# Signs login tokens (used from step 2 on). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Browser origins allowed to call the API, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://agongster.github.io
